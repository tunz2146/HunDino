		<Item class="Script" referent="RBX6CA2AB612891474F92B6257667A88199">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[
    Giant Tree Fall Script
    - When the game starts, the giant ancient tree falls down dramatically
    - Roots stay in place, trunk and canopy tip over and fall
]]

local Workspace = game:GetService("Workspace")

-- Wait for the tree to exist
local tree = Workspace:WaitForChild("GiantAncientTree", 10)
if not tree then
    warn("[GiantTreeFall] GiantAncientTree not found!")
    return
end

-- Find the parts
local trunkPart = nil
local canopyPart = nil
local rootsPart = nil

for _, desc in ipairs(tree:GetDescendants()) do
    if desc:IsA("MeshPart") then
        if desc.Name == "trunk_geom" then trunkPart = desc
        elseif desc.Name == "canopy_geom" then canopyPart = desc
        elseif desc.Name == "roots_geom" then rootsPart = desc
        end
    end
end

if not trunkPart then
    warn("[GiantTreeFall] Trunk part not found!")
    return
end

-- Keep roots anchored (staying in the ground)
if rootsPart then
    rootsPart.Anchored = true
    rootsPart.CanCollide = true
end

-- Unanchor trunk and canopy so they can fall
trunkPart.Anchored = false
trunkPart.CanCollide = true

if canopyPart then
    canopyPart.Anchored = false
    canopyPart.CanCollide = true
end

-- Give the trunk a push to make it tip over dramatically
-- The tree is at approximately (-6, 52, 66), falling towards +Z direction (towards the village)
local fallDirection = Vector3.new(0, 0, 1) -- Fall towards positive Z (toward village/front)

-- Apply initial angular velocity to tip the tree over
local angularVelocity = Vector3.new(0.3, 0, 0) -- Rotate around X axis to tip forward

-- Apply a combination of linear and angular velocity for a dramatic fall
if canopyPart then
    -- Push the top of the tree forward to start the tipping motion
    canopyPart.AssemblyLinearVelocity = fallDirection * 15 + Vector3.new(0, -5, 0)
end

trunkPart.AssemblyLinearVelocity = fallDirection * 5 + Vector3.new(0, -3, 0)

-- After a delay, re-anchor everything so the tree stays where it fell
task.delay(5, function()
    if trunkPart and trunkPart.Parent then
        trunkPart.Anchored = true
    end
    if canopyPart and canopyPart.Parent then
        canopyPart.Anchored = true
    end
    print("[GiantTreeFall] Tree has fallen and settled.")
end)

print("[GiantTreeFall] Giant tree is falling!")]]></ProtectedString>
