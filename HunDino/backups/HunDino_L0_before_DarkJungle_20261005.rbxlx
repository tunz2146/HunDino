		<Item class="Script" referent="RBXCB343ED61BD844D3991215801EEE4078">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[
    Base Claim System
    - Players can claim one base each using ProximityPrompt
    - Track ownership, update signs, allow unclaiming
    - Decorative tribal houses are pre-placed at each base, no spawning needed
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BaseEvents = ReplicatedStorage:WaitForChild("BaseEvents")
local ClaimEvent = BaseEvents:FindFirstChild("ClaimBase")
local UnclaimEvent = BaseEvents:FindFirstChild("UnclaimBase")
local Buildings = ReplicatedStorage:FindFirstChild("Buildings")

local Bases = workspace.ForestMap:FindFirstChild("Bases")
local BaseSigns = workspace:FindFirstChild("HunDinoL0") and workspace.HunDinoL0:FindFirstChild("BaseSigns")

-- ownership tracking: [baseName] = userId, [userId] = baseName
local baseOwners = {}      -- baseName -> userId
local playerBases = {}     -- userId -> baseName

-- Houses are decorative, pre-placed at each base. No spawning needed.

-- Function to update the sign text for a base
local function updateSign(baseName, ownerName)
    if not BaseSigns then return end
    local sign = BaseSigns:FindFirstChild(baseName)
    if not sign then return end
    local bgui = sign:FindFirstChild("SignGui")
    if not bgui then return end
    local label = bgui:FindFirstChild("OwnerLabel")
    if not label then return end
    
    if ownerName then
        label.Text = baseName .. "\n[" .. ownerName .. "]"
        label.TextColor3 = Color3.fromRGB(100, 255, 100)
    else
        label.Text = baseName .. "\n[Chua co nguoi nhan]"
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end

-- Function to update the claim pad appearance
local function updateClaimPad(baseName, claimed)
    if not Bases then return end
    local baseFolder = Bases:FindFirstChild(baseName)
    if not baseFolder then return end
    local claimPad = baseFolder:FindFirstChild("ClaimPad")
    if not claimPad then return end
    local prompt = claimPad:FindFirstChild("ClaimPrompt")
    
    if claimed then
        claimPad.Color = Color3.fromRGB(255, 100, 100)
        if prompt then
            prompt.ActionText = "Bo Nhan Base"
            prompt.Enabled = true
        end
    else
        claimPad.Color = Color3.fromRGB(80, 180, 255)
        if prompt then
            prompt.ActionText = "Nhan Base"
            prompt.Enabled = true
        end
    end
end

-- Function to remove a house from a base (no-op, houses are decorative)
local function removeHouseFromBase(baseName)
    -- Houses are pre-placed decoration, do not remove
end

-- Function to spawn a house on a claimed base (no-op, houses are decorative)
local function spawnHouseOnBase(baseName, houseIndex)
    -- Houses are pre-placed decoration, no spawning needed
end

-- Function to handle claiming
local function handleClaim(player, baseName)
    if not Bases then return "Bases folder not found" end
    local baseFolder = Bases:FindFirstChild(baseName)
    if not baseFolder then return "Base khong ton tai" end
    
    local userId = player.UserId
    
    -- Check if base is already owned by someone else
    if baseOwners[baseName] and baseOwners[baseName] ~= userId then
        return "Base nay da co nguoi nhan!"
    end
    
    -- Check if player already owns a different base
    if playerBases[userId] and playerBases[userId] ~= baseName then
        -- Unclaim the old base first
        local oldBase = playerBases[userId]
        baseOwners[oldBase] = nil
        removeHouseFromBase(oldBase)
        updateSign(oldBase, nil)
        updateClaimPad(oldBase, false)
    end
    
    -- Claim the new base
    baseOwners[baseName] = userId
    playerBases[userId] = baseName
    
    -- Houses are pre-placed, no spawning needed
    
    -- Update visuals
    updateSign(baseName, player.Name)
    updateClaimPad(baseName, true)
    
    return "Ban da nhan " .. baseName .. "!"
end

-- Function to handle unclaiming
local function handleUnclaim(player, baseName)
    if not Bases then return end
    local userId = player.UserId
    
    -- Verify ownership
    if baseOwners[baseName] ~= userId then
        return "Base nay khong phai cua ban!"
    end
    
    -- Unclaim
    baseOwners[baseName] = nil
    playerBases[userId] = nil
    
    removeHouseFromBase(baseName)
    updateSign(baseName, nil)
    updateClaimPad(baseName, false)
    
    return "Ban da bo nhan " .. baseName
end

-- Connect ProximityPrompts for all bases
local function setupPrompts()
    if not Bases then return end
    for _, baseFolder in ipairs(Bases:GetChildren()) do
        local claimPad = baseFolder:FindFirstChild("ClaimPad")
        if claimPad then
            local prompt = claimPad:FindFirstChild("ClaimPrompt")
            if prompt and not prompt:GetAttribute("Connected") then
                prompt.Triggered:Connect(function(player)
                    local isOwned = baseOwners[baseFolder.Name] ~= nil
                    if isOwned and baseOwners[baseFolder.Name] == player.UserId then
                        -- Owner triggered, unclaim
                        local msg = handleUnclaim(player, baseFolder.Name)
                    elseif not isOwned then
                        -- Not owned, claim it
                        local msg = handleClaim(player, baseFolder.Name)
                    else
                        -- Owned by someone else - do nothing
                    end
                end)
                prompt:SetAttribute("Connected", true)
            end
        end
    end
end

-- Also connect RemoteEvents as backup
if ClaimEvent then
    ClaimEvent.OnServerEvent:Connect(function(player, baseName)
        if typeof(baseName) == "string" then
            handleClaim(player, baseName)
        end
    end)
end

if UnclaimEvent then
    UnclaimEvent.OnServerEvent:Connect(function(player, baseName)
        if typeof(baseName) == "string" then
            handleUnclaim(player, baseName)
        end
    end)
end

-- Handle player leaving - keep their base (or unclaim if desired)
Players.PlayerRemoving:Connect(function(player)
    local userId = player.UserId
    local baseName = playerBases[userId]
    if baseName then
        -- Keep the base claimed even after leaving
        -- Uncomment below to auto-unclaim on leave:
        -- baseOwners[baseName] = nil
        -- playerBases[userId] = nil
        -- removeHouseFromBase(baseName)
        -- updateSign(baseName, nil)
        -- updateClaimPad(baseName, false)
    end
end)

-- Initialize
setupPrompts()

-- Handle bases added later
if Bases then
    Bases.ChildAdded:Connect(function(child)
        task.wait(0.1)
        setupPrompts()
    end)
end

print("[BaseClaimSystem] Khoi dong thanh cong! 12 bases san sang nhan.")]]></ProtectedString>
