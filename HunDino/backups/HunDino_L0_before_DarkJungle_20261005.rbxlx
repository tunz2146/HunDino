			<Item class="ModuleScript" referent="3652">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Các giá trị L0 là cấu hình thử, không phải cân bằng cuối của game.
return {
	Version = "L0.1",
	LobbyCapacity = 12,
	MaxStamina = 100,
	StaminaRegen = 20,
	RegenDelay = 0.75,
	WalkSpeed = 16,
	SprintSpeed = 25,
	SprintCost = 10,
	SheatheTime = 1,
	DodgeCost = 20,
	DodgeTime = 0.4,
	DodgeSpeed = 34,
	ComboWindow = 1,
	DummyHealth = 1000,
	PetDamage = 12,
	PetInterval = 4,
	Attacks = {
		Light = { Damage = 36, Cost = 8, Windup = 0.18, Duration = 0.55, Range = 9 },
		Heavy = { Damage = 70, Cost = 16, Windup = 0.45, Duration = 1.10, Range = 10 },
		Skill = { Damage = 50, Cost = 12, Windup = 0.3, Duration = 0.7, Range = 10 },
		Finisher = { Damage = 140, Cost = 20, Windup = 0.5, Duration = 1.2, Range = 12 },
	},
}
]]></ProtectedString>
					<string name="ScriptGuid">{E7A98C5A-9A92-4EFC-969F-B2A8D3089F46}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">TrainingConfig</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7b506f32714683270acc0bd800000465</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="3653">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Logic thuần: dùng chung với bài kiểm tra ngoài Studio.
local Rules = {}
function Rules.attack(config, state, action, now)
	if action ~= "Light" and action ~= "Heavy" and action ~= "Skill" then return nil end
	if not state.Drawn or now < state.BusyUntil or state.Sprinting then return nil end
	local step = if now <= state.ComboUntil then state.ComboStep else 0
	local kind = if action == "Skill" and step == 2 then "Finisher" else action
	local attack = config.Attacks[kind]
	if state.Stamina < attack.Cost then return nil end
	state.Stamina -= attack.Cost
	state.BusyUntil = now + attack.Duration
	state.LastSpend = state.BusyUntil
	state.ComboStep = if action == "Light" then 1 elseif action == "Heavy" and step == 1 then 2 else 0
	state.ComboUntil = state.BusyUntil + config.ComboWindow
	return kind, attack
end
function Rules.regenerate(config, state, now, dt)
	if not state.Sprinting and now >= state.BusyUntil and now - state.LastSpend >= config.RegenDelay then
		state.Stamina = math.min(config.MaxStamina, state.Stamina + config.StaminaRegen * dt)
	end
end
return Rules
]]></ProtectedString>
