          <string name="ScriptGuid">{1F5FC66D-0136-4C31-ADD0-8229D206135F}</string>
          <string name="Source"><![CDATA[print("HunDino đã chạy script từ VS Code!")
]]></string>
          <int64 name="SourceAssetId">-1</int64>
